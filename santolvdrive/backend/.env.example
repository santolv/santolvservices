# Variables nativas opcionales; el binario NO interpreta este archivo automáticamente.
# Recomendado: usar server.json y --config.
DATABASE_URL=postgres://drive:replace-me@127.0.0.1:5432/drive
APP_ORIGIN=http://localhost:8443
FRONTEND_ORIGIN=http://localhost:5500
BIND=127.0.0.1:8443
STORAGE_ROOT=data
# HTTPS local opcional: configurar ambos y ALLOW_INSECURE_LOCALHOST=false:
# TLS_CERT_FILE=certificate.pem
# TLS_KEY_FILE=private-key.pem
DEFAULT_QUOTA_BYTES=10737418240
TRASH_RETENTION_DAYS=30
RUST_LOG=santolvdrive=info,tower_http=info
# El acceso HTTP queda restringido al propio equipo:
ALLOW_INSECURE_LOCALHOST=true
