{
  "name": "super-cerebro-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/ui/app.js --bundle --minify --target=es2020 --outfile=src/ui/bundle.js && npm run build:craft",
    "build:craft": "esbuild src/ui/craft-merge.js --bundle --format=esm --minify --target=es2020 --outfile=src/ui/craft-merge.bundle.js",
    "check": "node --check src/ui/app.js && node --check src/ui/editor.js && node --check src/ui/markdown.js && node --check src/ui/notion.js && node --check src/ui/knowledge.js && node --check src/ui/hub.js && node --check src/ui/accounts.js && node --check src/ui/craft-editor.js && node --check src/ui/craft-merge.js && node --check src/ui/references.js && node --check src/ui/chat.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "diff": "^9.0.0",
    "dompurify": "^3.2.7",
    "fflate": "^0.8.3",
    "lucide": "^0.468.0",
    "marked": "^15.0.12",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  }
}
